{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "Microsoft.AspNetCore": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
                }
            }
        ],
        "Properties": {
            "ApplicationName": "Events.Api"
        }
    },
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://ubuntu:4317",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "OTEL_BSP_SCHEDULE_DELAY": "2000",
    "OTEL_BSP_EXPORT_TIMEOUT": "3000",
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Host=ubuntu;Port=5432;Database=coreevents-events;Username=postgres;Password=postgres"
    },
    "ApplicationSettings": {
        "Booking": {
            "MaxBookingsPerUser": 10
        }
    },
    "Kafka": {
        "BootstrapServers": "ubuntu:29092",
        "GroupId": "ConsumerGroup",
        "InitKafkaTopics": "true",
        "Topics": {
            "MainTopic": {
                "Partitions": 1,
                "ReplicationFactor": 1
            },
            "DeadLetterTopic": {
                "Partitions": 1,
                "ReplicationFactor": 1
            }
        }
    },
    "Redis": {
        "EndPoints": [
            "ubuntu:16379"
        ],
        "ConnectTimeout": 5000,
        "SyncTimeout": 3000,
        "AbortOnConnectFail": false,
        "ConnectRetry": 3
    },
    "Cache": {
        "Event": {
            "EventTtl": "00:05:00",
            "EventTopTtl": "01:00:00"
        }
    }
}
