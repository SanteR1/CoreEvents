{
  "name": "react-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:users": "openapi-typescript http://host.docker.internal:5003/swagger/v1/swagger.json -o src/shared/api/generated/users.d.ts",
    "gen:events": "openapi-typescript http://host.docker.internal:5004/swagger/v1/swagger.json -o src/shared/api/generated/events.d.ts",
    "gen:bookings": "openapi-typescript http://host.docker.internal:5005/swagger/v1/swagger.json -o src/shared/api/generated/bookings.d.ts",
    "gen:all": "npm run gen:users && npm run gen:events && npm run gen:bookings"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-dom": "^5.18.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-react-x": "^5.18.6",
    "globals": "^17.11.0",
    "oxc-transform-react": "^0.145.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "openapi-typescript": "^7.13.0"
  }
}
